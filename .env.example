# Copy to .env and adjust.
# Use 127.0.0.1, not localhost: on Windows, localhost can hang on IPv6 before falling back.
DATABASE_URL=postgresql://recs:recs@127.0.0.1:5432/recs

OLLAMA_HOST=http://localhost:11434
# Decision model. Any Ollama model that supports structured (JSON schema) output works,
# e.g. nimble, qwen3:8b, llama3.1:8b.
MODEL=nimble

# How many past queries to show the model (older ones are dropped first if the prompt gets too big).
HISTORY_WINDOW=15
# Stage 1: how many domains to pick (2 = safety net if the first guess is wrong).
TOP_DOMAINS=1
# Stage 2: how many questions to suggest.
NUM_SUGGESTIONS=3
# Rough prompt budget. Nimble's context is ~8K tokens; leave headroom for the answer.
MAX_PROMPT_TOKENS=6000
# Context window requested from Ollama. Its default (4096) is smaller than the budget above,
# and Ollama silently cuts off prompts that don't fit, so keep this above MAX_PROMPT_TOKENS.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=120
